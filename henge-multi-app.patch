+/* 终端会话里，程序的 stdin/stdout 是管道；但对它来说那是一条终端（isatty 是真、窗口大小真），
+   否则 Codex 这类 TUI 会当成被重定向而只输出纯文本。管道上的 ioctl 一律失败，所以这两条由这里代答。 */
+static int guest_isatty(int fd) { return fd >= 0 && fd <= 2 ? 1 : 0; }
+
+static int guest_ioctl(int fd, unsigned long req, ...) {
+    va_list ap;
+    va_start(ap, req);
+    void *arg = va_arg(ap, void *);
+    va_end(ap);
+    if (req == TIOCGWINSZ && arg) {
+        struct winsize *ws = (struct winsize *)arg;
+        ws->ws_col = (unsigned short)g_tty_cols;
+        ws->ws_row = (unsigned short)g_tty_rows;
+        ws->ws_xpixel = ws->ws_ypixel = 0;
+        return 0;
+    }
+    return ioctl(fd, req, arg);
+}

diff -ruN -x .git -x Screenshots -x third_party base/ios/Henge/DeviceRegion.swift work/ios/Henge/DeviceRegion.swift
--- base/ios/Henge/DeviceRegion.swift	1970-01-01 08:00:00.000000000 +0800
+++ work/ios/Henge/DeviceRegion.swift	2026-11-26 02:54:03.348463823 +0800
@@ -0,0 +1,72 @@
+import Foundation
+
+/// 这台机器是哪个地区卖的（国行 / 美版 / 港版……）。
+///
+/// 优先问 Apple 自己的 `MobileGestalt`（真实销售地区，`CH/A`、`LL/A` 这种），拿不到再退回系统地区设置。
+/// 只读，不改：转译运行的 Mac 应用问 `NSLocale` 时得到的也是真实地区，不会因为这里显示"国行"而被伪造。
+enum DeviceRegion {
+    /// 两个字母的地区码：CH、LL、ZP、J、KH……
+    static var code: String {
+        if let c = mobilGestalt("RegionCode"), !c.isEmpty { return c }
+        return Locale.current.region?.identifier ?? ""
+    }
+
+    /// 型号后缀里的那位（`CH/A` 的 CH），没有就返回 `code`。
+    static var salesCode: String {
+        if let m = mobilGestalt("ModelNumber"), let slash = m.firstIndex(of: "/") {
+            return String(m[..<slash])
+        }
+        return code
+    }
+
+    /// 一句人话：国行、美版、港版……
+    static var edition: String {
+        switch salesCode.uppercased() {
+        case "CH": return "国行"
+        case "LL": return "美版"
+        case "ZP", "ZA": return "港版"
+        case "ZQ", "ZE": return "澳门版"
+        case "J":  return "日版"
+        case "KH": return "韩版"
+        case "X", "XA": return "澳版"
+        case "B":  return "英版"
+        case "D":  return "德版"
+        case "F", "FD": return "法版"
+        case "C", "CL": return "加拿大版"
+        case "HN": return "印度版"
+        case "RU": return "俄版"
+        case "BR": return "巴西版"
+        case "MY": return "马来版"
+        case "TH": return "泰版"
+        case "VN": return "越版"
+        case "AE": return "阿联酋版"
+        case "SA": return "沙特版"
+        case "T", "TA": return "台版"
+        default:
+            let c = code.uppercased()
+            return c.isEmpty ? "未知" : c
+        }
+    }
+
+    /// 地区全名，给设置页显示。
+    static var regionName: String {
+        Locale.current.localizedString(forRegionCode: code) ?? code
+    }
+
+    /// 一行摘要：「国行 · 中国大陆 · CH」。
+    static var summary: String {
+        let parts = [edition, regionName, salesCode].filter { !$0.isEmpty }
+        return parts.joined(separator: " · ")
+    }
+
+    /// MobileGestalt 的字符串答案（私有 API；沙箱内可用，取不到就返回 nil）。
+    private static func mobilGestalt(_ key: String) -> String? {
+        guard let h = dlopen("/usr/lib/libMobileGestalt.dylib", RTLD_LAZY) else { return nil }
+        defer { dlclose(h) }
+        typealias MGCopyAnswerFunc = @convention(c) (CFString) -> Unmanaged<CFString>?
+        guard let sym = dlsym(h, "MGCopyAnswer") else { return nil }
+        let f = unsafeBitCast(sym, to: MGCopyAnswerFunc.self)
+        guard let v = f(key as CFString)?.takeRetainedValue() else { return nil }
+        return v as String
+    }
+}

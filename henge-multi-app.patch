 }
+
+/* ---- 交互终端：命令行程序跑在管道上，宿主喂输入、收输出 ---- */
+
+_Atomic int g_tty_active;
+static int g_tty_tx[2] = {-1, -1};  /* 宿主写 → 程序读（fd 0） */
+static int g_tty_rx[2] = {-1, -1};  /* 程序写 → 宿主读（fd 1/2） */
+static _Atomic int g_tty_running;
+static pthread_t g_tty_thread;
+static char g_tty_path[1024];
+
+static void *tty_thread(void *opaque) {
+    TlImage *exe = opaque;
+    int s0 = dup(0), s1 = dup(1), s2 = dup(2);
+    dup2(g_tty_tx[0], 0);
+    dup2(g_tty_rx[1], 1);
+    dup2(g_tty_rx[1], 2);
+    const char *argv[] = {g_tty_path, NULL};
+    char home[1100], cols[32], rows[32], term[64];
+    const char *tmp = getenv("TMPDIR");
+    snprintf(home, sizeof home, "HOME=%s", tmp && *tmp ? tmp : "/tmp");
+    snprintf(cols, sizeof cols, "COLUMNS=%d", g_tty_cols);
+    snprintf(rows, sizeof rows, "LINES=%d", g_tty_rows);
+    snprintf(term, sizeof term, "TERM=xterm-256color");
+    const char *envp[] = {home, cols, rows, term, "LANG=zh_CN.UTF-8", NULL};
+    atomic_store(&exit_code, tl_run_main(exe, 1, argv, envp));
+    fflush(NULL);
+    if (s0 >= 0) dup2(s0, 0), close(s0);
+    if (s1 >= 0) dup2(s1, 1), close(s1);
+    if (s2 >= 0) dup2(s2, 2), close(s2);
+    /* 关掉写端：宿主那边的 read 才会读到 EOF，而不是一直等到超时。 */
+    if (g_tty_rx[1] >= 0) close(g_tty_rx[1]), g_tty_rx[1] = -1;
+    atomic_store(&g_tty_running, 0);
+    return NULL;
+}
+
+/* 启动一个带终端的命令行程序。cols/rows 是它以为的窗口大小；返回 0，或 -1 并在 err 里说明。 */
+int henge_tl_tty_start(const char *path, int cols, int rows, char *err, size_t errlen) {
+    if (atomic_load(&runs)) return snprintf(err, errlen, "这次启动已经跑过一个程序了：退出 Henge 再打开。"), -1;
+    if (atomic_load(&g_tty_running)) return snprintf(err, errlen, "终端已经有一个程序在跑。"), -1;
+    int vm = henge_vm_state();
+    if (vm == 1 || vm == 3 || vm == 4) return snprintf(err, errlen, "先把 Mac 停掉。"), -1;
+    HengeDualMapping *jit = henge_ios_jit_get_mapping();
+    if (!jit || !jit->rw_addr || !jit->rx_addr) return snprintf(err, errlen, "请先开启 JIT。"), -1;
+    if (jit->size < 4 * (size_t)TL_REGION) return snprintf(err, errlen, "JIT 区域太小。"), -1;
+    g_tty_cols = cols > 0 ? cols : 80;
+    g_tty_rows = rows > 0 ? rows : 24;
+    if (pipe(g_tty_tx) || pipe(g_tty_rx)) {
+        snprintf(err, errlen, "建不出管道。");
+        return -1;
+    }
+    fcntl(g_tty_rx[0], F_SETFL, fcntl(g_tty_rx[0], F_GETFL) | O_NONBLOCK);
+    static TlHost host;
+    memset(&host, 0, sizeof host);
+    size_t at = jit->size - TL_REGION;
+    tl_host_init_region(&host, jit->rx_addr + at, jit->rw_addr + at, TL_REGION);
+    host.map_install_name = tl_ios_map_install_name;
+    host.shim_lookup = shim_lookup;
+    host.log = log_line;
+    host.soft_missing = 1;
+    atomic_store(&henge_tl_ran, 1);
+    atomic_store(&runs, 1);
+    atomic_store(&g_tty_active, 1);
+    snprintf(g_tty_path, sizeof g_tty_path, "%s", path);
+    TlImage *exe = tl_load(&host, path, err, errlen);
+    if (!exe) {
+        atomic_store(&g_tty_active, 0);
+        close(g_tty_tx[0]), close(g_tty_tx[1]), close(g_tty_rx[0]), close(g_tty_rx[1]);
+        return -1;
+    }
+    atomic_store(&g_tty_running, 1);
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, 8u << 20);
+    int rc = pthread_create(&g_tty_thread, &attr, tty_thread, exe);
+    pthread_attr_destroy(&attr);
+    if (rc) {
+        snprintf(err, errlen, "起不了线程。");
+        atomic_store(&g_tty_running, 0);
+        return -1;
+    }
+    return 0;
+}
+
+/* 读程序写到终端的东西。返回字节数；0 表示暂时没有；-1 表示结束了。 */
+int henge_tl_tty_read(char *buf, int cap) {
+    if (g_tty_rx[0] < 0) return -1;
+    ssize_t n = read(g_tty_rx[0], buf, (size_t)cap);
+    if (n > 0) return (int)n;
+    if (n == 0) return -1;
+    return errno == EAGAIN || errno == EWOULDBLOCK ? 0 : -1;
+}
+
+/* 把输入送给程序（按键、粘贴都算）。返回写入字节数。 */
+int henge_tl_tty_write(const char *buf, int len) {
+    if (g_tty_tx[1] < 0) return -1;
+    return (int)write(g_tty_tx[1], buf, (size_t)len);
+}
+
+void henge_tl_tty_resize(int cols, int rows) {
+    g_tty_cols = cols > 0 ? cols : 80;
+    g_tty_rows = rows > 0 ? rows : 24;
+}
+
+int henge_tl_tty_running(void) { return atomic_load(&g_tty_running); }
+
+const char *henge_tl_tty_path(void) { return g_tty_path; }
+
+/* 结束一个终端会话（程序退出后调用，释放管道）。 */
+void henge_tl_tty_stop(void) {
+    atomic_store(&g_tty_active, 0);
+    if (g_tty_tx[0] >= 0) close(g_tty_tx[0]), g_tty_tx[0] = -1;
+    if (g_tty_tx[1] >= 0) close(g_tty_tx[1]), g_tty_tx[1] = -1;
+    if (g_tty_rx[0] >= 0) close(g_tty_rx[0]), g_tty_rx[0] = -1;
+    if (g_tty_rx[1] >= 0) close(g_tty_rx[1]), g_tty_rx[1] = -1;
+}

diff -ruN -x .git -x Screenshots -x third_party base/ios/Henge/MacTerminal.swift work/ios/Henge/MacTerminal.swift
--- base/ios/Henge/MacTerminal.swift	1970-01-01 08:00:00.000000000 +0800
+++ work/ios/Henge/MacTerminal.swift	2026-11-26 02:51:36.501338398 +0800
@@ -0,0 +1,321 @@
+import SwiftUI
+import UIKit
+
+/// 一块终端屏幕：固定大小的字符网格，喂进程序吐出的字节流，吐出能显示的文本。
+///
+/// 只实现程序真正会用到的控制序列（光标定位、清屏清行、退格、制表、颜色忽略），够跑全屏 TUI；
+/// 更复杂的（滚动区、鼠标上报、替代字符集）不处理，遇到就跳过，不会把画面搞乱。
+struct TerminalScreen {
+    let cols: Int
+    let rows: Int
+    private var cells: [[Character]]
+    private var attr: [[Bool]]          // 是否加粗/高亮（只用亮度区分，颜色全部忽略）
+    private(set) var cx = 0
+    private(set) var cy = 0
+    private var pending = ""            // 半个 UTF-8 序列或未完成的转义序列
+
+    init(cols: Int = 80, rows: Int = 24) {
+        self.cols = max(20, cols)
+        self.rows = max(6, rows)
+        cells = Array(repeating: Array(repeating: " ", count: self.cols), count: self.rows)
+        attr = Array(repeating: Array(repeating: false, count: self.cols), count: self.rows)
+    }
+
+    var cursor: (Int, Int) { (cx, cy) }
+
+    mutating func feed(_ data: [UInt8]) {
+        pending += String(decoding: data, as: UTF8.self)
+        var text = Array(pending)
+        pending = ""
+        var i = 0
+        while i < text.count {
+            let c = text[i]
+            if c == "\u{1B}" {
+                if i + 1 >= text.count { pending = String(text[i...]); return }
+                let n = text[i + 1]
+                if n == "[" {
+                    var j = i + 2
+                    while j < text.count, !(text[j].isLetter || text[j] == "@" || text[j] == "`" || text[j] == "~") { j += 1 }
+                    if j >= text.count { pending = String(text[i...]); return }
+                    let body = String(text[(i + 2)..<j])
+                    csi(body, String(text[j]))
+                    i = j + 1
+                } else if n == "]" {
+                    // OSC ... BEL 或 ST
+                    var j = i + 2
+                    while j < text.count, text[j] != "\u{07}", !(text[j] == "\u{1B}" && j + 1 < text.count && text[j + 1] == "\\") { j += 1 }
+                    if j >= text.count { pending = String(text[i...]); return }
+                    i = j + 1
+                } else {
+                    i += 2
+                }
+                continue
+            }
+            put(c)
+            i += 1
+        }
+    }
+
+    private mutating func put(_ c: Character) {
+        switch c {
+        case "\n":
+            cy += 1
+            if cy >= rows { scrollUp() ; cy = rows - 1 }
+        case "\r":
+            cx = 0
+        case "\u{08}":
+            if cx > 0 { cx -= 1 }
+        case "\t":
+            cx = min(cols - 1, (cx / 8 + 1) * 8)
+        default:
+            if cx >= cols { cx = 0; cy += 1; if cy >= rows { scrollUp(); cy = rows - 1 } }
+            cells[cy][cx] = c
+            attr[cy][cx] = false
+            cx += 1
+        }
+    }
+
+    private mutating func scrollUp() {
+        cells.removeFirst()
+        cells.append(Array(repeating: " ", count: cols))
+        attr.removeFirst()
+        attr.append(Array(repeating: false, count: cols))
+    }
+
+    private mutating func csi(_ body: String, _ final: String) {
+        // 私有模式（?25h 这类）：光标显隐、括号粘贴，忽略
+        if body.hasPrefix("?") { return }
+        let parts = body.split(separator: ";", omittingEmptySubsequences: false).map { Int($0) ?? 0 }
+        let a = parts.first ?? 0
+        switch final {
+        case "H", "f":
+            let r = max(1, parts.count > 0 ? parts[0] : 1)
+            let c = max(1, parts.count > 1 ? parts[1] : 1)
+            cy = min(rows - 1, r - 1)
+            cx = min(cols - 1, c - 1)
+        case "J":
+            switch a {
+            case 0:
+                for x in cx..<cols { cells[cy][x] = " " }
+                for y in (cy + 1)..<rows { cells[y] = Array(repeating: " ", count: cols) }
+            case 1:
+                for y in 0..<cy { cells[y] = Array(repeating: " ", count: cols) }
+                for x in 0...min(cx, cols - 1) { cells[cy][x] = " " }
+            default:
+                cells = Array(repeating: Array(repeating: " ", count: cols), count: rows)
+                cx = 0; cy = 0
+            }
+        case "K":
+            switch a {
+            case 0: for x in cx..<cols { cells[cy][x] = " " }
+            case 1: for x in 0...min(cx, cols - 1) { cells[cy][x] = " " }
+            default: cells[cy] = Array(repeating: " ", count: cols)
+            }
+        case "A": cy = max(0, cy - max(1, a))
+        case "B": cy = min(rows - 1, cy + max(1, a))
+        case "C": cx = min(cols - 1, cx + max(1, a))
+        case "D": cx = max(0, cx - max(1, a))
+        case "G": cx = min(cols - 1, max(0, max(1, a) - 1))
+        case "d": cy = min(rows - 1, max(0, max(1, a) - 1))
+        default:
+            break   // 颜色、滚区、鼠标上报：忽略
+        }
+    }
+
+    /// 整屏文本，行尾空白去掉。
+    var text: String {
+        var out = ""
+        for row in cells {
+            var line = row
+            while let last = line.last, last == " " { line.removeLast() }
+            out += String(line) + "\n"
+        }
+        return out
+    }
+}
+
+/// 终端视图：只读文本 + 键盘，特殊键单独一排。
+final class MacTerminalView: UIView, UIKeyInput {
+    private let textView = UITextView()
+    private let keys = UIStackView()
+    private var timer: Timer?
+    private var screen = TerminalScreen()
+    private var running = false
+
+    var hasText: Bool { true }
+    var autocorrectionType: UITextAutocorrectionType { .no }
+    var autocapitalizationType: UITextAutocapitalizationType { .none }
+    var keyboardType: UIKeyboardType { .asciiCapable }
+    override var canBecomeFirstResponder: Bool { true }
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        backgroundColor = .black
+        textView.backgroundColor = .black
+        textView.textColor = UIColor(white: 0.92, alpha: 1)
+        textView.font = .monospacedSystemFont(ofSize: 11, weight: .regular)
+        textView.isEditable = false
+        textView.textContainerInset = UIEdgeInsets(top: 8, left: 8, bottom: 8, right: 8)
+        textView.translatesAutoresizingMaskIntoConstraints = false
+        addSubview(textView)
+
+        keys.axis = .horizontal
+        keys.distribution = .fillEqually
+        keys.spacing = 6
+        keys.translatesAutoresizingMaskIntoConstraints = false
+        for (title, seq) in [("esc", "\u{1B}"), ("tab", "\t"), ("⌃C", "\u{03}"), ("←", "\u{1B}[D"),
+                             ("↑", "\u{1B}[A"), ("↓", "\u{1B}[B"), ("→", "\u{1B}[C"), ("⏎", "\r")] {
+            let b = UIButton(type: .system)
+            b.setTitle(title, for: .normal)
+            b.titleLabel?.font = .systemFont(ofSize: 12, weight: .medium)
+            b.setTitleColor(.white, for: .normal)
+            b.backgroundColor = UIColor(white: 1, alpha: 0.12)
+            b.layer.cornerRadius = 6
+            b.addAction(UIAction { [weak self] _ in self?.send(seq) }, for: .touchUpInside)
+            keys.addArrangedSubview(b)
+        }
+        addSubview(keys)
+
+        NSLayoutConstraint.activate([
+            textView.topAnchor.constraint(equalTo: topAnchor),
+            textView.leadingAnchor.constraint(equalTo: leadingAnchor),
+            textView.trailingAnchor.constraint(equalTo: trailingAnchor),
+            keys.topAnchor.constraint(equalTo: textView.bottomAnchor, constant: 4),
+            keys.leadingAnchor.constraint(equalTo: leadingAnchor, constant: 8),
+            keys.trailingAnchor.constraint(equalTo: trailingAnchor, constant: -8),
+            keys.bottomAnchor.constraint(equalTo: safeAreaLayoutGuide.bottomAnchor, constant: -4),
+            keys.heightAnchor.constraint(equalToConstant: 32),
+        ])
+    }
+
+    required init?(coder: NSCoder) { fatalError("not used") }
+
+    func startTimer() {
+        timer?.invalidate()
+        timer = Timer.scheduledTimer(withTimeInterval: 1.0 / 30, repeats: true) { [weak self] _ in self?.drain() }
+    }
+
+    func stopTimer() {
+        timer?.invalidate()
+        timer = nil
+    }
+
+    private func drain() {
+        var buf = [CChar](repeating: 0, count: 8192)
+        var got = false
+        for _ in 0..<8 {
+            let n = henge_tl_tty_read(&buf, Int32(buf.count))
+            if n <= 0 { break }
+            got = true
+            let bytes = buf.prefix(Int(n)).map { UInt8(bitPattern: $0) }
+            screen.feed(bytes)
+        }
+        if got || !running { render() }
+        if running && henge_tl_tty_running() == 0 {
+            running = false
+            drain()
+            textView.text += "\n[进程已结束]"
+        }
+    }
+
+    private func render() {
+        let t = screen.text
+        if textView.text != t { textView.text = t }
+        let (x, y) = screen.cursor
+        let offset = t.split(separator: "\n", omittingEmptySubsequences: false).prefix(y).reduce(0) { $0 + $1.count + 1 }
+        let at = min(t.count, offset + min(x, screen.cols - 1))
+        textView.scrollRangeToVisible(NSRange(location: at, length: 0))
+    }
+
+    private func send(_ s: String) {
+        henge_tl_tty_write(s, Int32(s.utf8.count))
+    }
+
+    func insertText(_ text: String) { send(text) }
+    func deleteBackward() { send("\u{7F}") }
+
+    func setup(cols: Int, rows: Int) {
+        screen = TerminalScreen(cols: cols, rows: rows)
+        running = true
+        textView.text = ""
+        startTimer()
+    }
+
+    func resized(cols: Int, rows: Int) {
+        guard cols > 0, rows > 0 else { return }
+        henge_tl_tty_resize(Int32(cols), Int32(rows))
+    }
+}
+
+/// 终端外壳：选一个命令行程序，开跑。
+struct MacTerminalScreen: View {
+    let app: MacApp
+    @Environment(\.dismiss) private var dismiss
+    @State private var status = "启动中…"
+    @State private var cols = 80
+    @State private var rows = 24
+
+    var body: some View {
+        ZStack(alignment: .topLeading) {
+            MacTerminalRepresentable(cols: cols, rows: rows).ignoresSafeArea()
+            HStack(spacing: 8) {
+                Button { henge_tl_tty_stop(); dismiss() } label: {
+                    Image(systemName: "xmark").font(.system(size: 13, weight: .semibold))
+                        .foregroundStyle(.white.opacity(0.9)).frame(width: 32, height: 32)
+                        .background(.black.opacity(0.5), in: Circle())
+                }
+                if !status.isEmpty {
+                    Text(status).font(.system(size: 11, weight: .medium)).foregroundStyle(.white.opacity(0.85))
+                        .padding(.horizontal, 9).padding(.vertical, 5)
+                        .background(.black.opacity(0.5), in: Capsule())
+                }
+                Spacer()
+                Button {
+                    UIPasteboard.general.string.map { henge_tl_tty_write($0, Int32($0.utf8.count)) }
+                } label: {
+                    Image(systemName: "doc.on.clipboard").font(.system(size: 14))
+                        .foregroundStyle(.white.opacity(0.9)).frame(width: 32, height: 32)
+                        .background(.black.opacity(0.5), in: Circle())
+                }
+            }
+            .padding(10)
+        }
+        .statusBarHidden()
+        .task { start() }
+    }
+
+    private func start() {
+        let hub = MacTerminalHub.shared
+        guard !hub.started else { return }
+        hub.started = true
+        var err = [CChar](repeating: 0, count: 512)
+        let rc = henge_tl_tty_start(app.executable, Int32(cols), Int32(rows), &err, err.count)
+        if rc != 0 {
+            status = String(cString: err)
+            HengeLog.log("terminal", "启动失败：\(status)")
+            return
+        }
+        status = ""
+        hub.view?.setup(cols: cols, rows: rows)
+        hub.view?.becomeFirstResponder()
+    }
+}
+
+struct MacTerminalRepresentable: UIViewRepresentable {
+    let cols: Int
+    let rows: Int
+    func makeUIView(context: Context) -> MacTerminalView {
+        let v = MacTerminalView()
+        MacTerminalHub.shared.view = v
+        return v
+    }
+    func updateUIView(_ v: MacTerminalView, context: Context) { v.resized(cols: cols, rows: rows) }
+    static func dismantleUIView(_ v: MacTerminalView, coordinator: ()) { v.stopTimer() }
+}
+
+@MainActor
+final class MacTerminalHub {
+    static let shared = MacTerminalHub()
+    weak var view: MacTerminalView?
+    var started = false
+}

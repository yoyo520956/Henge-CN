diff -ruN -x .git -x Screenshots -x third_party base/ios/Henge/MacDesktop.swift work/ios/Henge/MacDesktop.swift
--- base/ios/Henge/MacDesktop.swift	1970-01-01 08:00:00.000000000 +0800
+++ work/ios/Henge/MacDesktop.swift	2026-11-26 02:54:21.079499899 +0800
@@ -0,0 +1,510 @@
+import SwiftUI
+import UIKit
+
+/// Several Mac apps on one screen, at once, through Henge's translation layer (experimental).
+///
+/// Each app is a namespace of the loader (henge_tl_app_add), so its globals and its libraries stay its own; they share
+/// this process, so they share one NSApplication and one menu bar. Every app's windows are drawn on one stage, in the
+/// app's own coordinates: a click goes to whichever window is under it, and the window's app becomes the front one
+/// (its menu bar takes the bar, as a Mac's does).
+///
+/// The screen the apps see is this view's size, in points, at a scale of 1 or 2, and never more than the device's own
+/// screen: the stage is scaled to fit, so shrinking the screen shrinks what each app thinks it has to draw on. An app
+/// lays out again when that changes, as a Mac does when its display is resized.
+final class MacDesktopUIView: UIView, UIKeyInput {
+    private let stage = CALayer()
+    private var holders: [Int: CALayer] = [:] // app namespace -> the layer its windows are put in
+    private var pump: CADisplayLink?
+    private var cursor = CGPoint.zero
+    private let arrow = CAShapeLayer()
+
+    /// The apps on this desktop, in the order they were opened.
+    private(set) var apps: [MacApp] = []
+    /// The app whose menus are in the bar.
+    private(set) var active: Int = 0
+    /// The screen given to the apps, in points.
+    private(set) var screen = CGSize(width: 1180, height: 680)
+    private(set) var scale: CGFloat = 2
+
+    /// How much of the room there is the apps get: 1 is all of it, below 1 gives them a smaller screen to draw on (less
+    /// work, and everything drawn larger). It never goes past the device's own panel either way.
+    var density: Double {
+        get { MacRuntime.effectiveDensity }
+        set {
+            MacScreenSize.density = newValue
+            fitScreen()
+        }
+    }
+
+    /// Touch works the pointer where the finger lands; trackpad moves it with the fingers, as on a Mac's pad.
+    var trackpad = UserDefaults.standard.object(forKey: MacScreenUIView.trackpadKey) as? Bool ?? true
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        backgroundColor = UIColor(white: 0.08, alpha: 1)
+        isMultipleTouchEnabled = true
+        stage.anchorPoint = .zero
+        stage.isGeometryFlipped = true // the Mac's way up: the origin at the bottom left
+        stage.masksToBounds = true
+        stage.backgroundColor = UIColor(white: 0.16, alpha: 1).cgColor
+        layer.addSublayer(stage)
+        arrow.path = MacDesktopUIView.arrowPath()
+        arrow.fillColor = UIColor.white.cgColor
+        arrow.strokeColor = UIColor.black.withAlphaComponent(0.55).cgColor
+        arrow.lineWidth = 1
+        arrow.isHidden = true
+        layer.addSublayer(arrow)
+
+        let tap = UITapGestureRecognizer(target: self, action: #selector(tapped(_:)))
+        let twoTap = UITapGestureRecognizer(target: self, action: #selector(rightTapped(_:)))
+        twoTap.numberOfTouchesRequired = 2
+        let long = UILongPressGestureRecognizer(target: self, action: #selector(pressed(_:)))
+        let pan = UIPanGestureRecognizer(target: self, action: #selector(dragged(_:)))
+        pan.maximumNumberOfTouches = 1
+        let twoPan = UIPanGestureRecognizer(target: self, action: #selector(scrolled(_:)))
+        twoPan.minimumNumberOfTouches = 2
+        twoPan.maximumNumberOfTouches = 2
+        for g in [tap, twoTap, long, pan, twoPan] as [UIGestureRecognizer] {
+            g.delegate = self
+            addGestureRecognizer(g)
+        }
+    }
+
+    required init?(coder: NSCoder) { fatalError("not used") }
+
+    // MARK: - apps
+
+    /// Loads one more app beside the ones already here. nil on success, or a reason. Loading happens off the main
+    /// thread (a big app takes seconds); what it builds is put on the stage when it is done.
+    @MainActor
+    func add(_ app: MacApp) async -> String? {
+        if let why = MacMemoryGuard.whyCannotOpenAnother(openCount: Int(henge_tl_app_count())) {
+            HengeLog.log("macdesktop", "不开 \(app.name)：\(why)")
+            return why
+        }
+        MacMemoryGuard.logBeforeOpen(app.name)
+        let path = app.url.path
+        let loaded: (Int32, String) = await Task.detached(priority: .userInitiated) {
+            var e = [CChar](repeating: 0, count: 512)
+            let n = henge_tl_app_add(path, &e, e.count)
+            return (n, String(cString: e))
+        }.value
+        let (ns, reason) = loaded
+        guard ns >= 0 else {
+            HengeLog.log("macdesktop", "could not load \(app.name): \(reason)")
+            return reason.isEmpty ? "could not load it" : reason
+        }
+        apps.append(app)
+        fitScreen()
+        makeFront(Int(ns))
+        HengeLog.log("macdesktop", "\(app.name) is app \(ns) of \(henge_tl_app_count())")
+        // The C side logs when an app's main returns; a closure that captured ns could not be a C function pointer.
+        henge_tl_app_run_soon_ns(ns, nil)
+        return nil
+    }
+
+    func makeFront(_ ns: Int) {
+        active = ns
+        henge_tl_app_set_active(Int32(ns))
+        refresh()
+    }
+
+    // MARK: - the screen
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        fitScreen()
+        placeStage()
+    }
+
+    private func placeStage() {
+        guard screen.width > 0, screen.height > 0 else { return }
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        stage.bounds = CGRect(origin: .zero, size: screen)
+        stage.position = CGPoint(x: bounds.midX, y: bounds.midY)
+        // The apps draw on `screen` points; this is what makes it fit whatever room there is.
+        let k = min(bounds.width / screen.width, bounds.height / screen.height)
+        stage.transform = CATransform3DMakeScale(k, k, 1)
+        CATransaction.commit()
+        refresh()
+    }
+
+    /// Gives the apps the room this view has, in points, at the device's scale, scaled by `density`, and never more
+    /// than the device's own panel. Called when the view is laid out and when the setting changes.
+    func fitScreen() {
+        guard bounds.width > 1, bounds.height > 1 else { return }
+        let (size, s) = MacScreenSize.fit(room: bounds.size, density: density)
+        guard size != screen || s != scale else { return }
+        screen = size
+        scale = s
+        HengeLog.log("macdesktop", "screen \(Int(size.width))x\(Int(size.height)) at \(s)x, \(apps.count) app(s)")
+        henge_tl_app_set_screen(size.width, size.height, s)
+        placeStage()
+    }
+
+    // MARK: - drawing
+
+    /// Puts every app's windows at their place, back to front, above the windows of the app that was opened first.
+    func refresh() {
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        let total = Int(henge_tl_app_window_count())
+        var seen = Set<ObjectIdentifier>()
+        for i in 0..<total {
+            guard let raw = henge_tl_app_window_layer(Int32(i)) else { continue }
+            let root = Unmanaged<CALayer>.fromOpaque(raw).takeUnretainedValue()
+            var x = 0.0, y = 0.0, w = 0.0, h = 0.0
+            guard henge_tl_app_window_frame(Int32(i), &x, &y, &w, &h) == 0 else { continue }
+            let ns = Int(henge_tl_app_window_ns(Int32(i)))
+            let holder: CALayer
+            if let h = holders[ns] {
+                holder = h
+            } else {
+                holder = CALayer()
+                holder.anchorPoint = .zero
+                holder.isGeometryFlipped = true
+                stage.addSublayer(holder)
+                holders[ns] = holder
+            }
+            if root.superlayer !== holder {
+                root.removeFromSuperlayer()
+                holder.addSublayer(root)
+            }
+            holder.frame = CGRect(x: x, y: y, width: w, height: h)
+            seen.insert(ObjectIdentifier(holder))
+        }
+        for (ns, h) in holders where !seen.contains(ObjectIdentifier(h)) { h.removeFromSuperlayer(); holders[ns] = nil }
+        // The front app's windows above the others.
+        if let front = holders[active] { front.zPosition = 1 }
+        for (ns, h) in holders where ns != active { h.zPosition = 0 }
+        CATransaction.commit()
+    }
+
+    // MARK: - input
+
+    /// A point in this view to the apps' screen (points, origin at the bottom left).
+    private func mac(_ p: CGPoint) -> CGPoint {
+        let k = stage.transform.m11
+        guard k > 0 else { return .zero }
+        return CGPoint(x: (p.x - stage.position.x) / k + screen.width / 2,
+                       y: (p.y - stage.position.y) / k + screen.height / 2)
+    }
+
+    private func moveCursor(to p: CGPoint) {
+        cursor = p
+        arrow.isHidden = false
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        arrow.path = MacDesktopUIView.arrowPath()
+        arrow.position = stage.convert(p, to: layer)
+        CATransaction.commit()
+    }
+
+    private static func arrowPath() -> CGPath {
+        let p = UIBezierPath()
+        p.move(to: .zero)
+        p.addLine(to: CGPoint(x: 0, y: 17))
+        p.addLine(to: CGPoint(x: 4.5, y: 13))
+        p.addLine(to: CGPoint(x: 7.5, y: 19.5))
+        p.addLine(to: CGPoint(x: 10, y: 18.4))
+        p.addLine(to: CGPoint(x: 7.2, y: 12))
+        p.addLine(to: CGPoint(x: 12.5, y: 12))
+        p.close()
+        return p.cgPath
+    }
+
+    private func mouse(_ type: Int32, _ p: CGPoint, clicks: Int32 = 1, flags: UInt = 0) {
+        let q = mac(p)
+        moveCursor(to: q)
+        henge_tl_app_mouse(type, q.x, q.y, clicks, flags)
+    }
+
+    /// Which app is under a point, so a click makes it the front one.
+    private func front(_ p: CGPoint) {
+        let q = mac(p)
+        let n = Int(henge_tl_app_window_count())
+        for i in (0..<max(0, n)).reversed() {
+            var x = 0.0, y = 0.0, w = 0.0, h = 0.0
+            guard henge_tl_app_window_frame(Int32(i), &x, &y, &w, &h) == 0 else { continue }
+            if q.x >= x, q.x < x + w, q.y >= y, q.y < y + h {
+                let ns = Int(henge_tl_app_window_ns(Int32(i)))
+                if ns != active, ns >= 0 { makeFront(ns) }
+                return
+            }
+        }
+    }
+
+    @objc private func tapped(_ g: UITapGestureRecognizer) {
+        let p = g.location(in: self)
+        front(p)
+        mouse(5, p, clicks: 0)
+        mouse(1, p)
+        mouse(2, p)
+    }
+
+    @objc private func rightTapped(_ g: UITapGestureRecognizer) {
+        let p = g.location(in: self)
+        front(p)
+        mouse(5, p, clicks: 0)
+        mouse(3, p)
+        mouse(4, p)
+    }
+
+    @objc private func pressed(_ g: UILongPressGestureRecognizer) {
+        let p = g.location(in: self)
+        switch g.state {
+        case .began: front(p); mouse(5, p, clicks: 0); mouse(1, p)
+        case .ended: mouse(2, p)
+        default: break
+        }
+    }
+
+    @objc private func dragged(_ g: UIPanGestureRecognizer) {
+        let p = g.location(in: self)
+        switch g.state {
+        case .began: mouse(5, p, clicks: 0); mouse(1, p)
+        case .changed: mouse(6, p)
+        case .ended, .cancelled: mouse(2, p)
+        default: break
+        }
+    }
+
+    @objc private func scrolled(_ g: UIPanGestureRecognizer) {
+        guard trackpad else { return }
+        let d = g.translation(in: self)
+        let p = g.location(in: self)
+        switch g.state {
+        case .began: break
+        case .changed:
+            let k = stage.transform.m11 > 0 ? stage.transform.m11 : 1
+            henge_tl_app_scroll(mac(p).x, mac(p).y, -d.x / k, d.y / k, 1)
+            g.setTranslation(.zero, in: self)
+        case .ended, .cancelled: henge_tl_app_scroll(mac(p).x, mac(p).y, 0, 0, 4)
+        default: break
+        }
+    }
+
+    // MARK: - the event loop
+
+    func start() {
+        pump?.invalidate()
+        let l = CADisplayLink(target: self, selector: #selector(tick))
+        // 每秒泵几次事件由设置和热状态决定：Mac 应用的画面是 CPU 画出来的，帧率直接等于发热。
+        l.preferredFramesPerSecond = MacRuntime.effectiveFPS
+        l.add(to: .main, forMode: .common)
+        pump = l
+        thermalObserver = MacRuntime.watchThermal { [weak self] in self?.applyThrottle() }
+        applyThrottle()
+    }
+
+    /// 热状态或设置变了：重设帧率与密度（应用会收到屏幕变化通知并重新布局）。
+    func applyThrottle() {
+        pump?.preferredFramesPerSecond = MacRuntime.effectiveFPS
+        fitScreen()
+    }
+
+    func stop() {
+        pump?.invalidate()
+        pump = nil
+        if let o = thermalObserver { NotificationCenter.default.removeObserver(o); thermalObserver = nil }
+    }
+
+    @objc private func tick() {
+        // One event a frame at most: the apps' own timers and animations run on this thread's run loop on the way.
+        // The pump runs a nested run loop, which can call this again: the guard stops that from recursing.
+        guard !pumping else { return }
+        pumping = true
+        _ = henge_tl_app_pump(0)
+        pumping = false
+        refresh()
+    }
+    private var pumping = false
+    private var thermalObserver: NSObjectProtocol?
+
+    // MARK: - keyboard
+
+    var hasText: Bool { true }
+    var autocorrectionType: UITextAutocorrectionType { .no }
+    var autocapitalizationType: UITextAutocapitalizationType { .none }
+    var keyboardType: UIKeyboardType { .asciiCapable }
+
+    func insertText(_ text: String) {
+        let flags: UInt = text.count == 1 && text.first.map { $0.isUppercase } == true ? 0x20000 : 0
+        henge_tl_app_key(1, 0, text, flags)
+        henge_tl_app_key(0, 0, text, flags)
+    }
+
+    func deleteBackward() {
+        henge_tl_app_key(1, 51, "\u{7f}", 0) // Delete
+        henge_tl_app_key(0, 51, "\u{7f}", 0)
+    }
+
+    override var canBecomeFirstResponder: Bool { true }
+}
+
+extension MacDesktopUIView: UIGestureRecognizerDelegate {
+    func gestureRecognizer(_ g: UIGestureRecognizer, shouldRecognizeSimultaneouslyWith other: UIGestureRecognizer) -> Bool {
+        false
+    }
+}
+
+/// The shell: the stage, a bar with the apps that are open (tap one to bring it to the front), and the resolution menu.
+struct MacDesktopScreen: View {
+    let apps: [MacApp]
+    @Environment(\.dismiss) private var dismiss
+    @State private var status = "Opening…"
+    @State private var opened = false
+    @State private var density = MacScreenSize.density
+    @State private var front = 0
+    @State private var names: [String] = []
+    @State private var memTokens: [NSObjectProtocol] = []
+    @State private var trackpad = UserDefaults.standard.object(forKey: MacScreenUIView.trackpadKey) as? Bool ?? true
+
+    var body: some View {
+        ZStack(alignment: .topLeading) {
+            MacDesktopRepresentable(density: density)
+                .ignoresSafeArea()
+            VStack(alignment: .leading, spacing: 8) {
+                HStack(spacing: 8) {
+                    Button { dismiss() } label: {
+                        Image(systemName: "xmark").font(.system(size: 13, weight: .semibold))
+                            .foregroundStyle(.white.opacity(0.9)).frame(width: 34, height: 34)
+                            .background(.black.opacity(0.45), in: Circle())
+                    }
+                    if !status.isEmpty {
+                        Text(status).font(.system(size: 12, weight: .medium)).foregroundStyle(.white.opacity(0.85))
+                            .padding(.horizontal, 10).padding(.vertical, 6).background(.black.opacity(0.45), in: Capsule())
+                    }
+                    Spacer()
+                    Button {
+                        trackpad.toggle()
+                        MacDesktopHub.shared.view?.trackpad = trackpad
+                        UserDefaults.standard.set(trackpad, forKey: MacScreenUIView.trackpadKey)
+                    } label: {
+                        Image(systemName: trackpad ? "cursorarrow" : "hand.point.up.left").font(.system(size: 15))
+                            .foregroundStyle(.white.opacity(0.9)).frame(width: 34, height: 34)
+                            .background(.black.opacity(0.45), in: Circle())
+                    }
+                    Menu {
+                        Section("屏幕密度") {
+                            ForEach([("整个屏幕", 1.0), ("四分之三", 0.75), ("一半", 0.5)], id: \.0) { name, d in
+                                Button(name) { density = d; MacScreenSize.density = d }
+                            }
+                        }
+                        Section("帧率") {
+                            ForEach([("60 帧", 60), ("30 帧", 30), ("20 帧", 20)], id: \.1) { name, f in
+                                Button(name) { MacRuntime.fps = f; MacDesktopHub.shared.view?.applyThrottle() }
+                            }
+                        }
+                    } label: {
+                        Image(systemName: "rectangle.compress.vertical").font(.system(size: 15))
+                            .foregroundStyle(.white.opacity(0.9)).frame(width: 34, height: 34)
+                            .background(.black.opacity(0.45), in: Circle())
+                    }
+                }
+                if names.count > 1 {
+                    // The apps open here, front one marked: tap one to bring it to the front (its menu bar).
+                    HStack(spacing: 6) {
+                        ForEach(Array(names.enumerated()), id: \.offset) { i, name in
+                            Button {
+                                front = i
+                                MacDesktopHub.shared.view?.makeFront(i)
+                            } label: {
+                                Text(name).font(.system(size: 11, weight: .semibold))
+                                    .foregroundStyle(i == front ? .black : .white.opacity(0.9))
+                                    .padding(.horizontal, 9).padding(.vertical, 5)
+                                    .background(i == front ? Color.white.opacity(0.9) : Color.black.opacity(0.45), in: Capsule())
+                            }
+                        }
+                    }
+                }
+            }
+            .padding(12)
+        }
+        .statusBarHidden()
+        .task { await start() }
+        .onDisappear { memTokens.forEach { NotificationCenter.default.removeObserver($0) }; memTokens = [] }
+    }
+
+    private func start() async {
+        guard !opened else { return }
+        opened = true
+        var failed = 0
+        guard let view = MacDesktopHub.shared.view else { status = "No desktop"; return }
+        // Side by side: no app owns the main thread's run loop; the desktop pumps it for all of them.
+        henge_tl_app_set_multi(1)
+        // 内存吃紧时主动让步：降密度、降帧，而不是等 iOS 把整个 Henge 杀掉。
+        memTokens = MacMemoryGuard.watch { msg in
+            if MacMemoryGuard.shouldRelax() {
+                MacScreenSize.density = min(MacScreenSize.density, 0.75)
+                MacRuntime.fps = min(MacRuntime.fps, 20)
+                MacDesktopHub.shared.view?.applyThrottle()
+            }
+            status = msg
+        }
+        for app in apps {
+            if henge_tl_app_count() >= Int32(MacRuntime.maxApps) {
+                failed += 1
+                status = "最多同时开 \(MacRuntime.maxApps) 个应用（可在设置里调）"
+                break
+            }
+            status = "正在打开 \(app.name)…"
+            if let reason = await view.add(app) {
+                failed += 1
+                status = "\(app.name): \(reason)"
+                try? await Task.sleep(nanoseconds: 1_500_000_000)
+            }
+            names = apps.filter { view.apps.contains($0) }.map(\.name)
+        }
+        status = failed == 0 ? "" : "\(failed) could not open"
+        view.start()
+        try? await Task.sleep(nanoseconds: 3_000_000_000)
+        if failed == 0 { status = "" }
+    }
+}
+
+/// The desktop view, as SwiftUI shows it.
+struct MacDesktopRepresentable: UIViewRepresentable {
+    let density: Double
+    func makeUIView(context: Context) -> MacDesktopUIView {
+        let v = MacDesktopUIView()
+        v.density = density
+        MacDesktopHub.shared.view = v
+        return v
+    }
+    func updateUIView(_ v: MacDesktopUIView, context: Context) {
+        if v.density != density { v.density = density }
+        v.refresh()
+    }
+    static func dismantleUIView(_ v: MacDesktopUIView, coordinator: ()) { v.stop() }
+}
+
+@MainActor
+final class MacDesktopHub {
+    static let shared = MacDesktopHub()
+    weak var view: MacDesktopUIView?
+}
+
+/// The screen a Mac app is given: the room there is (the view's size in points), scaled by a density the user picks,
+/// at 2x at most (the apps draw in software), and never more than the device's own panel in pixels.
+enum MacScreenSize {
+    static let key = "henge.macapps.density"
+    static var density: Double {
+        get { let v = UserDefaults.standard.object(forKey: key) as? Double ?? 1; return min(max(v, 0.5), 1) }
+        set { UserDefaults.standard.set(min(max(newValue, 0.5), 1), forKey: key) }
+    }
+
+    /// (points the app gets, its backing scale). Widths and heights are even numbers: a window at half a point would
+    /// be drawn on half a pixel.
+    static func fit(room: CGSize, density: Double) -> (CGSize, CGFloat) {
+        let panel = UIScreen.main.nativeBounds.size                 // in pixels
+        let s = min(max(UIScreen.main.scale, 1), 2)                 // 2x at most
+        let most = CGSize(width: panel.width / s, height: panel.height / s)
+        let d = min(max(density, 0.5), 1)
+        let w = min(room.width, most.width) * d
+        let h = min(room.height, most.height) * d
+        let even = { (v: CGFloat) in max(320, (v / 2).rounded(.down) * 2) }
+        return (CGSize(width: even(w), height: even(h)), s)
+    }
+}

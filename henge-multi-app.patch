--- base/ios/Henge/Native/henge-tl-identity.c	1970-01-01 08:00:00.000000000 +0800
+++ work/ios/Henge/Native/henge-tl-identity.c	2026-11-26 02:54:48.535619043 +0800
@@ -0,0 +1,111 @@
+/* What a Mac program running through the translation layer is told this machine is.
+ *
+ * Only the fields an app shows in "About This Mac" are answered here; everything an app *works* with (the OS
+ * version, the CPU count, the time, the network, identifiers, the file system) is the real one, from iOS. Faking
+ * those breaks apps: version checks refuse to start, certificate and nonce code fails, and a machine whose clock or
+ * memory size lies is a machine apps crash on. So this is display only.
+ *
+ * The values are the ones Henge reports for its Macs (an Apple silicon Mac the app's macOS recognises), except that
+ * the model reads "iPhone OS", the chip "Apple A12Z" and the memory 4 GB, as configured here.
+ *
+ * Region is NOT faked: NSLocale answers the device's real region, so an app that asks where the machine is gets the
+ * truth (China → 国行, United States → 美版, and so on). */
+#include <sys/sysctl.h>
+#include <string.h>
+#include <stdio.h>
+
+#include "henge-tl-identity.h"
+
+/* Set by henge_tl_identity_set(); NULL/0 means "answer nothing, let iOS answer". */
+static char g_model[64];
+static char g_chip[64];
+static unsigned long long g_memsize;
+static int g_ncpu;
+
+void henge_tl_identity_set(const char *model, const char *chip, unsigned long long memsize, int ncpu) {
+    snprintf(g_model, sizeof g_model, "%s", model ? model : "");
+    snprintf(g_chip, sizeof g_chip, "%s", chip ? chip : "");
+    g_memsize = memsize;
+    g_ncpu = ncpu;
+}
+
+/* A string-valued sysctl answered here: 1 if it was one of ours. */
+static int answer_string(const char *name, void *oldp, size_t *oldlenp) {
+    const char *v = NULL;
+    if (*g_model && (!strcmp(name, "hw.model") || !strcmp(name, "hw.targettype"))) v = g_model;
+    else if (*g_chip && (!strcmp(name, "machdep.cpu.brand_string") || !strcmp(name, "hw.chip"))) v = g_chip;
+    if (!v) return 0;
+    size_t n = strlen(v) + 1;
+    if (oldp && oldlenp) {
+        if (*oldlenp < n) { *oldlenp = n; return 1; }
+        memcpy(oldp, v, n);
+        *oldlenp = n;
+    }
+    return 1;
+}
+
+/* 验机与硬件检测类软件会读的一整组固定值：芯片、频率、缓存、页大小。
+   A12Z 的实际规格（8 核、2.5 GHz、128 字节 cache line、16 KB 页）。这些是"这台机器是什么"的一部分，
+   和 hw.model 属于同一类展示信息；改它们不会影响程序怎么跑，只影响报告出来的规格。 */
+static const struct { const char *name; unsigned long long value; int width; } kFacts[] = {
+    {"machdep.cpu.core_count", 8, 4},
+    {"machdep.cpu.thread_count", 8, 4},
+    {"machdep.cpu.logical_cpu_max", 8, 4},
+    {"hw.physicalcpu", 8, 4},
+    {"hw.physicalcpu_max", 8, 4},
+    {"hw.cpufrequency", 2500000000ULL, 8},
+    {"hw.cpufrequency_max", 2500000000ULL, 8},
+    {"hw.cachelinesize", 128, 4},
+    {"hw.l1icachesize", 131072, 8},
+    {"hw.l1dcachesize", 65536, 8},
+    {"hw.l2cachesize", 8388608, 8},
+    {"hw.pagesize", 16384, 4},
+    {"hw.memsize", 0, 8},        /* filled from g_memsize */
+    {"hw.memsize_usable", 0, 8},
+    {"hw.ncpu", 0, 4},           /* filled from g_ncpu */
+    {"hw.activecpu", 0, 4},
+    {"hw.logicalcpu", 0, 4},
+    {"hw.logicalcpu_max", 0, 4},
+    {"hw.availablecpu", 0, 4},
+};
+
+static int answer_int(const char *name, void *oldp, size_t *oldlenp) {
+    unsigned long long v = 0;
+    int width = 0;
+    for (size_t i = 0; i < sizeof kFacts / sizeof *kFacts; i++) {
+        if (strcmp(name, kFacts[i].name)) continue;
+        v = kFacts[i].value;
+        width = kFacts[i].width;
+        /* 计数字段跟配置走，频率与缓存保持表里的固定值：hw.cpufrequency 里也有 "cpu"，不能按子串判断。 */
+        if (!strcmp(name, "hw.memsize") || !strcmp(name, "hw.memsize_usable")) {
+            v = g_memsize;
+        } else if (!strcmp(name, "hw.ncpu") || !strcmp(name, "hw.activecpu") || !strcmp(name, "hw.logicalcpu") ||
+                   !strcmp(name, "hw.logicalcpu_max") || !strcmp(name, "hw.availablecpu") ||
+                   !strcmp(name, "hw.physicalcpu") || !strcmp(name, "hw.physicalcpu_max") ||
+                   !strcmp(name, "machdep.cpu.core_count") || !strcmp(name, "machdep.cpu.thread_count") ||
+                   !strcmp(name, "machdep.cpu.logical_cpu_max")) {
+            v = (unsigned long long)g_ncpu;
+        }
+        break;
+    }
+    if (!width) return 0;
+    if (oldp && oldlenp) {
+        if (*oldlenp < (size_t)width) { *oldlenp = (size_t)width; return 1; }
+        if (width == 8) memcpy(oldp, &v, 8);
+        else { int w = (int)v; memcpy(oldp, &w, 4); }
+        *oldlenp = (size_t)width;
+    }
+    return 1;
+}
+
+/* A program's sysctlbyname, through the loader's shim: ours for the display fields, the real one for everything
+ * else (including every kern.*, so version checks keep working). */
+int henge_tl_sysctlbyname(const char *name, void *oldp, size_t *oldlenp, void *newp, size_t newlen) {
+    if (name && !newp) {
+        if (answer_string(name, oldp, oldlenp)) return 0;
+        if (answer_int(name, oldp, oldlenp)) return 0;
+    }
+    /* The real one: this file is not what libSystem exports here, so the call reaches iOS's own implementation.
+       (Only the guest's imports are pointed at this function.) */
+    return sysctlbyname(name, oldp, oldlenp, newp, newlen);
+}

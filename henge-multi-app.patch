+/* ---- several programs side by side --------------------------------------------------------------
+
+   A namespace is one process's world inside this process: its own copy of every library it loads (its own
+   globals), its own main executable, its own large reservations. Programs the app itself starts already get one
+   each (processes_as_threads). These let the host give a second, unrelated program a namespace of its own, so
+   several Mac apps can be loaded and run at once where the host cannot fork: each keeps its globals apart, and
+   the region's `used` counter places them one after another.
+
+   What stays shared, because the host has one process: the Objective-C runtime (so two copies of a framework's
+   class still collide: a second app bringing its own Foundation is not isolated), the C library, and whatever the
+   app and the host both bind to. Give each app its own TlHost (its own region) when they must not share an address
+   space at all, or one region and let them take turns. */
+
+/* A namespace number no program of the app's uses yet (1...), or 0 when there are none left. */
+int tl_reserve_ns(void);
+/* Loads path as the program of namespace ns (one from tl_reserve_ns). 0 is the first program: same as tl_load. */
+TlImage *tl_load_as(TlHost *host, const char *path, int ns, char *err, size_t errlen);

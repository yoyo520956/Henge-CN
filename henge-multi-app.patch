diff -ruN -x .git -x Screenshots -x third_party base/ios/Henge/MacMemoryGuard.swift work/ios/Henge/MacMemoryGuard.swift
--- base/ios/Henge/MacMemoryGuard.swift	1970-01-01 08:00:00.000000000 +0800
+++ work/ios/Henge/MacMemoryGuard.swift	2026-11-26 02:54:11.979626014 +0800
@@ -0,0 +1,71 @@
+import Foundation
+import UIKit
+
+/// 内存看门狗：iOS 不会跟你商量，物理内存吃紧就直接 SIGKILL 整个进程，没有回调。
+///
+/// 所以这里做两件事：
+/// 1. **事前拒绝**：开新应用前先看还剩多少可用内存，不够就不开，给出人话提示，而不是让系统把 Henge 杀掉。
+/// 2. **事中让步**：收到内存警告、或可用内存跌破警戒线时，主动降屏幕密度、降帧率、停止后台应用的刷新，
+///    把内存还给系统。这不能阻止被杀，但能把被杀的门槛推后很多。
+///
+/// `henge_available_memory()` 是 `os_proc_available_memory()` 的封装：iOS 认为这个进程还能用多少，
+/// 比 `physicalMemory - used` 准，因为它算进了 jetsam 给 App 的额度。
+enum MacMemoryGuard {
+    /// 低于这个数就不再开新应用（MB）。留 600 MB 给 iOS 弹键盘、拍照、收通知。
+    static let reserveMB = 600
+    /// 跌破这个数就降密度（MB）。
+    static let lowWaterMB = 900
+
+    static var availableMB: Int { Int(henge_available_memory() >> 20) }
+
+    /// 还能不能再开一个：nil 表示可以，否则是不能的理由。
+    static func whyCannotOpenAnother(openCount: Int) -> String? {
+        if openCount >= MacRuntime.maxApps {
+            return "最多同时开 \(MacRuntime.maxApps) 个应用，可以在设置里调高。"
+        }
+        let mb = availableMB
+        if mb < lowWaterMB {
+            return "可用内存只剩 \(mb) MB，再开一个会把 Henge 一起拖死。先关掉一些应用再试。"
+        }
+        // 一个中等 AppKit 应用启动时峰值约 200–400 MB。
+        if mb < reserveMB + 300 {
+            return "可用内存只剩 \(mb) MB，不够再开一个应用了。"
+        }
+        return nil
+    }
+
+    /// 现在该不该降一档（可用内存偏低，或系统刚发过内存警告）。
+    @MainActor
+    static func shouldRelax() -> Bool {
+        availableMB < lowWaterMB || warnedRecently
+    }
+
+    private static var warnedRecently = false
+    private static var lastWarn: Date = .distantPast
+
+    /// 开始盯内存。`onRelax` 在需要让步时调用（宿主把它接到降密度上）。
+    @MainActor
+    static func watch(onRelax: @escaping (String) -> Void) -> [NSObjectProtocol] {
+        var tokens: [NSObjectProtocol] = []
+        let c = NotificationCenter.default
+        tokens.append(c.addObserver(forName: UIApplication.didReceiveMemoryWarningNotification,
+                                   object: nil, queue: .main) { _ in
+            warnedRecently = true
+            lastWarn = Date()
+            HengeLog.log("memguard", "内存警告，可用 \(availableMB) MB")
+            onRelax("系统内存吃紧，已自动降低画面精度")
+            // 五分钟后警告的影响消退。
+            DispatchQueue.main.asyncAfter(deadline: .now() + 300) { warnedRecently = false }
+        })
+        tokens.append(c.addObserver(forName: UIApplication.didEnterBackgroundNotification,
+                                   object: nil, queue: .main) { _ in
+            HengeLog.log("memguard", "进入后台，可用 \(availableMB) MB")
+        })
+        return tokens
+    }
+
+    /// 每次开新应用前打一行，出事时好回溯。
+    static func logBeforeOpen(_ name: String) {
+        HengeLog.log("memguard", "准备打开 \(name)：可用 \(availableMB) MB，已开 \(henge_tl_app_count()) 个")
+    }
+}
diff -ruN -x .git -x Screenshots -x third_party base/ios/Henge/MacRuntime.swift work/ios/Henge/MacRuntime.swift
--- base/ios/Henge/MacRuntime.swift	1970-01-01 08:00:00.000000000 +0800
+++ work/ios/Henge/MacRuntime.swift	2026-11-26 02:49:28.434323986 +0800
@@ -0,0 +1,100 @@
+import Foundation
+import UIKit
+
+/// 性能与节流：转译运行的 Mac 应用共用的帧率、屏幕密度、并发上限，以及过热时的自动降级。
+///
+/// 这些应用全部跑在 Henge 进程里、用 CPU 画图，所以真正决定"卡不卡、烫不烫"的是三个旋钮：
+/// 每秒泵几次事件、应用以为自己的屏幕有多大、同时开几个。默认值按"4 GB 机型能用"选，
+/// 用户可以在设置里改；过热时无论设置如何都会自动降一档，凉下来再自动恢复。
+enum MacRuntime {
+    static let fpsKey = "henge.macapps.fps"            // 60 / 30 / 20
+    static let maxAppsKey = "henge.macapps.maxApps"    // 2 / 3 / 5 / 8
+    static let thermalKey = "henge.macapps.thermal"    // 过热时自动降级
+    static let adaptiveKey = "henge.macapps.adaptive"  // 掉帧时自动降密度
+
+    /// 屏幕刷新上限，默认 30：Mac 应用的窗口是软件画出来的，60 帧会把 CPU 吃满。
+    static var fps: Int {
+        get { let v = UserDefaults.standard.integer(forKey: fpsKey); return [20, 30, 60].contains(v) ? v : 30 }
+        set { UserDefaults.standard.set(newValue, forKey: fpsKey) }
+    }
+
+    /// 同时能开几个应用。
+    static var maxApps: Int {
+        get { let v = UserDefaults.standard.integer(forKey: maxAppsKey); return [2, 3, 5, 8].contains(v) ? v : 3 }
+        set { UserDefaults.standard.set(newValue, forKey: maxAppsKey) }
+    }
+
+    /// 过热时自动降帧、降密度（默认开）。
+    static var thermalAware: Bool {
+        get { UserDefaults.standard.object(forKey: thermalKey) as? Bool ?? true }
+        set { UserDefaults.standard.set(newValue, forKey: thermalKey) }
+    }
+
+    /// 实测掉帧时自动降密度（默认开）。
+    static var adaptive: Bool {
+        get { UserDefaults.standard.object(forKey: adaptiveKey) as? Bool ?? true }
+        set { UserDefaults.standard.set(newValue, forKey: adaptiveKey) }
+    }
+
+    /// 过热降级：0 正常，1 温热（帧率减半），2 烫（帧率 20、密度 0.75），3 危险（帧率 20、密度 0.5）。
+    private(set) static var throttleLevel = 0
+
+    /// 当前真正生效的帧率。
+    static var effectiveFPS: Int {
+        switch throttleLevel {
+        case 1: return min(fps, 30)
+        case 2, 3: return 20
+        default: return fps
+        }
+    }
+
+    /// 当前真正生效的密度（在用户选择的基础上再乘一个过热系数）。
+    static var effectiveDensity: Double {
+        let base = MacScreenSize.density
+        switch throttleLevel {
+        case 2: return min(base, 0.75)
+        case 3: return min(base, 0.5)
+        default: return base
+        }
+    }
+
+    /// iOS 报告的热状态，映射成降级档。实测：`serious` 在长跑 10 分钟后出现，`critical` 很少见。
+    static func level(for state: ProcessInfo.ThermalState) -> Int {
+        switch state {
+        case .nominal: return 0
+        case .fair: return 1
+        case .serious: return 2
+        case .critical: return 3
+        @unknown default: return 1
+        }
+    }
+
+    /// 记下热状态；变了就返回 true，调用方据此重设帧率与密度。
+    @discardableResult
+    static func note(_ state: ProcessInfo.ThermalState) -> Bool {
+        let l = thermalAware ? level(for: state) : 0
+        guard l != throttleLevel else { return false }
+        throttleLevel = l
+        HengeLog.log("macapps", "thermal \(state.rawValue) → throttle \(l), fps \(effectiveFPS), density \(effectiveDensity)")
+        return true
+    }
+
+    /// 开始盯热状态（`MacDesktopScreen` 出现时调用）。
+    static func watchThermal(_ onChange: @escaping () -> Void) -> NSObjectProtocol {
+        NotificationCenter.default.addObserver(forName: ProcessInfo.thermalStateDidChangeNotification,
+                                               object: nil, queue: .main) { _ in
+            if note(ProcessInfo.processInfo.thermalState) { onChange() }
+        }
+    }
+
+    /// 一句人话，给设置页显示。
+    static var thermalSummary: String {
+        switch ProcessInfo.processInfo.thermalState {
+        case .nominal: return "正常"
+        case .fair: return "温热"
+        case .serious: return "偏烫，已降速"
+        case .critical: return "很烫，已降到最低"
+        @unknown default: return "未知"
+        }
+    }
+}
